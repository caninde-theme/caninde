  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "role": "syntax.comment",
      "fontStyle": "italic"
    },
    {
      "name": "Variables",
      "scope": ["variable", "string constant.other.placeholder"],
      "role": "syntax.variable"
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "role": "syntax.parameter",
      "fontStyle": "italic"
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.variable.property",
        "entity.name.tag.yaml"
      ],
      "role": "syntax.property"
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "punctuation.definition.template-expression"
      ],
      "role": "syntax.keyword"
    },
    {
      "name": "Operators and separators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "role": "syntax.operator"
    },
    {
      "name": "this and self",
      "scope": ["variable.language", "variable.parameter.function.language"],
      "role": "syntax.keyword",
      "fontStyle": "italic"
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive"
      ],
      "role": "syntax.type"
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic"
      ],
      "role": "syntax.function"
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "role": "syntax.string"
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.regexp"],
      "role": "syntax.regexp"
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape", "string.regexp constant.character.escape"],
      "role": "syntax.escape"
    },
    {
      "name": "Numbers and units",
      "scope": ["constant.numeric", "keyword.other.unit"],
      "role": "syntax.number"
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "role": "syntax.constant"
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "role": "syntax.tag"
    },
    {
      "name": "Tag punctuation",
      "scope": ["punctuation.definition.tag"],
      "role": "syntax.punctuation"
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "role": "syntax.attribute"
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "meta.decorator entity.name.function",
        "meta.decorator variable.other.readwrite",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "role": "syntax.decorator"
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "role": "syntax.punctuation"
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "role": "syntax.invalid"
    },
    {
      "name": "Markup: headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section.markdown",
        "punctuation.definition.heading"
      ],
      "role": "markup.heading",
      "fontStyle": "bold"
    },
    {
      "name": "Markup: bold",
      "scope": ["markup.bold", "punctuation.definition.bold"],
      "role": "markup.bold",
      "fontStyle": "bold"
    },
    {
      "name": "Markup: italic",
      "scope": ["markup.italic", "punctuation.definition.italic"],
      "role": "fg.default",
      "fontStyle": "italic"
    },
    {
      "name": "Markup: links",
      "scope": ["markup.underline.link", "markup.underline.link.image", "string.other.link"],
      "role": "markup.link",
      "fontStyle": "underline"
    },
    {
      "name": "Markup: code",
      "scope": ["markup.inline.raw", "markup.raw", "markup.fenced_code"],
      "role": "markup.code"
    },
    {
      "name": "Markup: quotes",
      "scope": ["markup.quote", "punctuation.definition.quote"],
      "role": "markup.quote",
      "fontStyle": "italic"
    },
    {
      "name": "Markup: list markers",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "role": "accent.secondary"
    },
    {
      "name": "Diff: inserted",
      "scope": ["markup.inserted"],
      "role": "status.success"
    },
    {
      "name": "Diff: deleted",
      "scope": ["markup.deleted"],
      "role": "status.error"
    },
    {
      "name": "Diff: changed",
      "scope": ["markup.changed"],
      "role": "accent.primary"
    }
  ],
  "semanticTokenColors": {
    "namespace": { "role": "syntax.type" },
    "class": { "role": "syntax.type" },
    "interface": { "role": "syntax.type" },
    "enum": { "role": "syntax.type" },
    "struct": { "role": "syntax.type" },
    "typeParameter": { "role": "syntax.type" },
    "type": { "role": "syntax.type" },
    "function": { "role": "syntax.function" },
    "method": { "role": "syntax.function" },
    "macro": { "role": "syntax.function" },
    "property": { "role": "syntax.property" },
    "enumMember": { "role": "syntax.constant" },
    "variable.readonly": { "role": "syntax.constant" },
    "parameter": { "role": "syntax.parameter", "fontStyle": "italic" },
    "decorator": { "role": "syntax.decorator" },
    "number": { "role": "syntax.number" },
    "regexp": { "role": "syntax.regexp" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
