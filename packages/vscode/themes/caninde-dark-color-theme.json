    "toolbar.activeBackground": "#474E57",
    "scrollbarSlider.background": "#7F879140",
    "scrollbarSlider.hoverBackground": "#7F879166",
    "scrollbarSlider.activeBackground": "#7F87918C",
    "minimap.selectionHighlight": "#1E9BD7",
    "minimap.findMatchHighlight": "#F2B01E",
    "minimapSlider.background": "#7F879126",
    "menu.background": "#1E252D",
