    "extensionButton.prominentBackground": "#1E9BD7",
    "extensionButton.prominentForeground": "#060C13",
    "extensionButton.prominentHoverBackground": "#76C8FA",
    "extensionBadge.remoteBackground": "#F2B01E",
    "extensionBadge.remoteForeground": "#060C13",
    "badge.background": "#F2B01E",
