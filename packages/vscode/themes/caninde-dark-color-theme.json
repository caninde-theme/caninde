    "terminal.background": "#11161E",
    "terminal.foreground": "#E7EFFB",
    "terminal.selectionBackground": "#1E9BD759",
    "terminalCursor.foreground": "#F2B01E",
    "terminal.ansiBlack": "#2D333C",
    "terminal.ansiRed": "#E85D52",
    "terminal.ansiGreen": "#A3B83A",
    "terminal.ansiYellow": "#F2B01E",
    "terminal.ansiBlue": "#1E9BD7",
    "terminal.ansiMagenta": "#C77FD8",
    "terminal.ansiCyan": "#2BB5B0",
    "terminal.ansiWhite": "#BDC5D0",
    "terminal.ansiBrightBlack": "#7F8791",
    "terminal.ansiBrightRed": "#FFA195",
    "terminal.ansiBrightGreen": "#B5CA5C",
    "terminal.ansiBrightYellow": "#FFCB6F",
    "terminal.ansiBrightBlue": "#76C8FA",
    "terminal.ansiBrightMagenta": "#E2A2F1",
    "terminal.ansiBrightCyan": "#6BD2CD",
    "terminal.ansiBrightWhite": "#F4F9FF"
