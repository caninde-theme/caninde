  "tokenColors": [
    {
      "name": "At-rule punctuation follows the keyword",
      "scope": [
        "punctuation.definition.keyword"
      ],
      "settings": {
        "foreground": "#1E9BD7"
      }
    },
    {
      "name": "URLs inside url() are not parameters",
      "scope": [
        "variable.parameter.url"
      ],
      "settings": {
        "foreground": "#A3B83A"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7F8791",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#E7EFFB"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#FDA75D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.variable.property",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#76C8FA"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#1E9BD7"
      }
    },
    {
      "name": "Operators and separators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#9DA5B0"
      }
    },
    {
      "name": "this and self",
      "scope": [
        "variable.language",
        "variable.parameter.function.language"
      ],
      "settings": {
        "foreground": "#1E9BD7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.type.primitive",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#2BB5B0"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#F2B01E"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A3B83A"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.regexp"
      ],
      "settings": {
        "foreground": "#E2A2F1"
      }
    },
    {
      "name": "Escape sequences",
      "scope": [
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#C77FD8"
      }
    },
    {
      "name": "Numbers and units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#E8892B"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#E8892B"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#1E9BD7"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9DA5B0"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D2991E"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "meta.decorator entity.name.function",
        "meta.decorator variable.other.readwrite",
        "storage.type.annotation",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#C77FD8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#9DA5B0"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#E85D52"
      }
    },
    {
      "name": "Markup: headings",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "entity.name.section.markdown",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#F2B01E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "foreground": "#E8892B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "foreground": "#E7EFFB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup: links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#76C8FA",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup: code",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#A3B83A"
      }
    },
    {
      "name": "Markup: quotes",
      "scope": [
        "markup.quote",
        "punctuation.definition.quote"
      ],
      "settings": {
        "foreground": "#9DA5B0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup: list markers",
      "scope": [
        "punctuation.definition.list.begin.markdown",
        "beginning.punctuation.definition.list.markdown"
      ],
      "settings": {
        "foreground": "#F2B01E"
      }
    },
    {
      "name": "Diff: inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A3B83A"
      }
    },
    {
      "name": "Diff: deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E85D52"
      }
    },
    {
      "name": "Diff: changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#1E9BD7"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": {
      "foreground": "#2BB5B0"
    },
    "class": {
      "foreground": "#2BB5B0"
    },
    "interface": {
      "foreground": "#2BB5B0"
    },
    "enum": {
      "foreground": "#2BB5B0"
    },
    "struct": {
      "foreground": "#2BB5B0"
    },
    "typeParameter": {
      "foreground": "#2BB5B0"
    },
    "type": {
      "foreground": "#2BB5B0"
    },
    "function": {
      "foreground": "#F2B01E"
    },
    "method": {
      "foreground": "#F2B01E"
    },
    "macro": {
      "foreground": "#F2B01E"
    },
    "property": {
      "foreground": "#76C8FA"
    },
    "enumMember": {
      "foreground": "#E8892B"
    },
    "variable.readonly": {
      "foreground": "#E8892B"
    },
    "parameter": {
      "foreground": "#FDA75D",
      "fontStyle": "italic"
    },
    "decorator": {
      "foreground": "#C77FD8"
    },
    "number": {
      "foreground": "#E8892B"
    },
    "regexp": {
      "foreground": "#E2A2F1"
    },
    "*.deprecated": {
      "fontStyle": "strikethrough"
    }
  }
}
